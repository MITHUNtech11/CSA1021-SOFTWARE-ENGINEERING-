# Environment Configuration for Smart Campus Platform
# Sensitive and deployment-specific values managed separately from committed code

# Server Configuration
PORT=8000
HOST=0.0.0.0
INSTANCE_ID=backend-primary

# Database Configuration (Relative path for SQLite WAL, or postgresql://user:pass@host:5432/db)
DATABASE_PATH=smart_campus.db

# Security & Secrets
SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External Integration Webhooks (Mock stubs provided for offline safety)
GITHUB_ISSUES_WEBHOOK_URL=https://api.github.com/repos/campus/ops/issues
SLACK_INCIDENT_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/WEBHOOK
