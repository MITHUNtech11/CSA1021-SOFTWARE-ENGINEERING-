pipeline {
    agent any
    environment {
        IMAGE_NAME = 'mithun/container-app'
        BUILD_TAG = "${env.BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checking out code from Git repository..."
            }
        }
        stage('Lint & Static Analysis') {
            steps {
                sh 'python -m py_compile app.py'
                echo "Code syntax verified successfully."
            }
        }
        stage('Unit Testing') {
            steps {
                sh 'pytest test_app.py -v'
            }
        }
        stage('Docker Build & Package') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:${BUILD_TAG} ."
            }
        }
        stage('Deploy to Staging') {
            steps {
                sh "docker run -d -p 8080:80 ${IMAGE_NAME}:${BUILD_TAG}"
                echo "Application successfully deployed to staging container!"
            }
        }
    }
    post {
        always {
            echo 'Pipeline execution finished.'
        }
        success {
            echo 'CI/CD Pipeline Build SUCCESSFUL!'
        }
    }
}
